# Server port. On Railway (and similar), the platform sets PORT; default 4000 for local.
PORT=4000
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# PostgreSQL connection string. On Railway: use the URL from your Postgres service (Variables tab).
# Local: postgresql://user:password@localhost:5432/freight_ai
# Docker with Postgres on host: use host.docker.internal instead of localhost.
DATABASE_URL=postgresql://user:password@localhost:5432/freight_ai

# Upload storage (optional; defaults below). On Railway, disk is ephemeral unless you add a volume.
UPLOAD_DIR=uploads
PENDING_UPLOAD_DIR=uploads/pending